APP_NAME=DevPilot AI API
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
# Production uses PostgreSQL. SQLite is available only by explicit local development configuration.
DATABASE_URL=postgresql+psycopg://devpilot:devpilot@localhost:5432/devpilot
JWT_SECRET=replace-with-a-random-value-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_REQUEST_TIMEOUT=30
AI_MAX_RETRIES=2
# Optional per-model prices, USD per million tokens. Unknown model prices remain null.
AI_MODEL_PRICING_JSON={}
AI_MAX_OUTPUT_TOKENS=4000
# Optional Java analyzer configuration. The JAR and config file must be installed locally.
CHECKSTYLE_JAR=
CHECKSTYLE_CONFIG=
# Build infra/test-sandbox-python and set the resulting image by immutable digest to enable test jobs.
TEST_SANDBOX_IMAGE=
TEST_SANDBOX_TIMEOUT_SECONDS=30
TEST_SANDBOX_MEMORY=256m
TEST_SANDBOX_CPUS=1.0
TEST_SANDBOX_PIDS=64
TEST_SANDBOX_OUTPUT_BYTES=65536
